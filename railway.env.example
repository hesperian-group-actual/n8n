# Paste into Railway → your n8n service → Variables → RAW editor
# https://docs.railway.com/variables
#
# Also set DB_* / N8N_* secrets your instance needs (Postgres URL, encryption key, etc.)

# --- Cost / serverless (reduce outbound traffic while idle) ---

# Stop anonymous telemetry to n8n.io / PostHog
N8N_DIAGNOSTICS_ENABLED=false

# Stop periodic execution pruning DB queries (every 15–60 min)
EXECUTIONS_DATA_PRUNE=false

# Idle-aware wait tracker: no DB poll every 60s when nothing is waiting
# (requires deploy with idle-aware WaitTracker — see PR on cursor/railway-cost-reduction-7264)
N8N_WAIT_TRACKER_IDLE_POLLING=true

# Optional: slower poll while executions are in a Wait node (seconds, default 60)
# N8N_WAIT_TRACKER_POLL_INTERVAL=600

# Slow workflow-history compaction (default window 2h → runs ~hourly).
# Interval is roughly TIME_WINDOW_HOURS / 2, so 12 ≈ every 6 hours.
# Cuts Neon Rows spikes from catalog churn during optimizeHistories().
N8N_WORKFLOW_HISTORY_OPTIMIZING_TIME_WINDOW_HOURS=12

# --- Operational reminders (not env vars) ---
# - Deactivate workflows you do not need 24/7 (especially polling triggers).
# - Close the n8n UI tab when idle (WebSocket keepalive counts as outbound).
# - Postgres on Railway private network still counts as outbound traffic.
